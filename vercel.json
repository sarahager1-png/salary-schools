{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/cron/monthly-open",    "schedule": "0 4 1 * *" },
    { "path": "/api/cron/report-reminder", "schedule": "0 6 3 * *" },
    { "path": "/api/cron/report-due",      "schedule": "0 15 5 * *" },
    { "path": "/api/cron/payroll-cutoff",  "schedule": "0 15 6 * *" },
    { "path": "/api/cron/maternity-watch", "schedule": "0 * * * *" },
    { "path": "/api/cron/queue-drain",     "schedule": "*/10 * * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ]
}
